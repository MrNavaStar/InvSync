{
  "schemaVersion": 1,
  "id": "invsync",
  "version": "${version}",
  "name": "InvSync",
  "description": "Syncs player inventories, XP, health, effects, advancements and stats between servers through a shared SQLite file.",
  "authors": [
    "MrNavaStar"
  ],
  "license": "MIT",
  "icon": "assets/invsync/icon.png",
  "environment": "server",
  "entrypoints": {
    "server": [
      "mrnavastar.invsync.InvSync"
    ]
  },
  "mixins": [
    "invsync.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": ">=26.2"
  }
}
